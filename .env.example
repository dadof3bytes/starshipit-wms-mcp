# Local / Inspector only. Production (Viktor) sends the Starshipit API key
# as Authorization: Bearer, x-api-key, or starshipit-api-key on each request.
STARSHIPIT_API_KEY=

# http (default) or stdio
TRANSPORT=http
PORT=3000
HOST=127.0.0.1

# Comma-separated Host header values allowed when binding publicly.
# Required in production when HOST=0.0.0.0
ALLOWED_HOSTS=

# Set to true to hide write tools (receive, pick/pack, stocktake, etc.).
STARSHIPIT_WMS_READ_ONLY=false
