# Local / Inspector only. Production MCP clients send the Starshipit API key
# as Authorization: Bearer, x-api-key, or starshipit-api-key on each request.
STARSHIPIT_API_KEY=

# http (default) or stdio
TRANSPORT=http
PORT=3000
HOST=127.0.0.1

# Optional host allowlist for /mcp when binding publicly (HOST=0.0.0.0).
# Leave empty to accept any Host header. If set, must match your public domain exactly.
# Example: your-mcp.example.com
ALLOWED_HOSTS=

# Writes are enabled by default. Set to true to hide write tools (receive, pick/pack, stocktake, etc.).
STARSHIPIT_WMS_READ_ONLY=false
